# Local source awaiting review, site settings, and data
/private/
/source-review/
/local/
/config/local.*
/config/*.local.*
/data/
/input/
/inputs/
/output/
/outputs/
/reports/
/exports/
/logs/
/backups/

# Credentials and local environment
.env
.env.*
!.env.example
.Renviron
.Renviron.*
*.pem
*.key
credentials.*
secrets.*

# R sessions, serialized records, and local package libraries
.Rhistory
.RData
.RDataTmp
.Ruserdata
.Rproj.user/
*.rds
*.RDS
*.rda
*.RData
renv/library/
renv/staging/
renv/cache/

